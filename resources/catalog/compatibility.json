  "profiles": {
    "messages-adaptive": {
      "protocols": {
        "messages": {
          "adaptiveThinking": true
        }
      }
    },
    "messages-budget": {
      "protocols": {
        "messages": {
          "effortFormat": "unsupported",
          "thinkingBudget": {
            "min": 1024,
            "max": 63999
          }
        }
      }
    },
    "messages-budget-effort": {
      "protocols": {
        "messages": {
          "effortFormat": "messages",
          "thinkingBudget": {
            "min": 1024,
            "max": 63999
          }
        }
      }
    },
    "chat-thinking-level": {
      "protocols": {
        "chatCompletions": {
          "effortFormat": "unsupported"
        }
      }
    },
    "chat-required-sampling": {
      "protocols": {
        "chatCompletions": {
          "modelOptions": {
            "top_p": 0.95
          }
        }
      }
    }
  },
