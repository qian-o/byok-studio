{
  "schemaVersion": 1,
  "fallback": "other",
  "vendors": [
    {
      "id": "openai",
      "name": "OpenAI",
      "protocol": "responses",
      "pattern": "^(gpt[-.]|chatgpt[-.]|codex(?:[-.]|$)|o[134](?:[-.]|$))"
    },
    {
      "id": "claude",
      "name": "Claude",
      "protocol": "messages",
      "pattern": "^claude(?:[-.]|$)"
    },
    {
      "id": "grok",
      "name": "Grok",
      "protocol": "chatCompletions",
      "pattern": "^grok(?:[-.]|$)"
    },
    {
      "id": "gemini",
      "name": "Gemini",
      "protocol": "chatCompletions",
      "pattern": "^gemini(?:[-.]|$)"
    },
    {
      "id": "doubao",
      "name": "Doubao",
      "protocol": "chatCompletions",
      "pattern": "^doubao(?:[-.]|$)"
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "protocol": "chatCompletions",
      "pattern": "^deepseek(?:[-.]|$)"
    },
    {
      "id": "glm",
      "name": "GLM",
      "protocol": "chatCompletions",
      "pattern": "^(?:glm|chatglm)(?:[-.]|$)"
    },
    {
      "id": "kimi",
      "name": "Kimi",
      "protocol": "chatCompletions",
      "pattern": "^(?:kimi|moonshot)(?:[-.]|$)"
    },
    {
      "id": "other",
      "name": "其他",
      "protocol": "chatCompletions"
    }
  ],
  "exclusions": [
    {
      "kind": "video",
      "pattern": "^(?:sora|veo|kling|seedance|wan(?:\\d|[-.])|grok-imagine-video|doubao-(?:seedance|video))(?:[-.\\d]|$)"
    },
    {
      "kind": "image",
      "pattern": "^(?:gpt-image|dall-e|imagen|seedream|grok-imagine(?:-image)?|doubao-(?:seedream|image))(?:[-.\\d]|$)"
    },
    {
      "kind": "image",
      "pattern": "^gemini.*(?:-image(?:[-.]|$)|-imagegen(?:[-.]|$))"
    },
    {
      "kind": "non-chat",
      "pattern": "^(?:text-embedding|embedding|whisper|tts|gpt.*-(?:audio|realtime|transcribe|tts))(?:[-.]|$)"
    }
  ],
  "models": {}
}
